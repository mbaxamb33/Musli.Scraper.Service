# Server Configuration
PORT=8081
ENVIRONMENT=development

# Database Configuration (matches your Makefile)
JOB_DB_TYPE=postgres
JOB_DB_URL=postgresql://root:secret@localhost:5433/musli_scraper?sslmode=disable

# Browser Configuration
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=60s
BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Scraping Configuration
MAX_CONCURRENCY=3
REQUEST_DELAY=1s
MAX_RETRIES=3

# Worker Configuration
WORKER_COUNT=2
JOB_TIMEOUT=300s